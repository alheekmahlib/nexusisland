# ── Apple signing / notarization (for build-and-release.sh) ─────────────────
APPLE_ID=your@email.com
APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
TEAM_ID=XXXXXXXXXX
SIGNING_IDENTITY=Developer ID Application: Your Name (XXXXXXXXXX)

# ── Cloudflare R2 (for publish-release.sh — auto-update hosting) ────────────
# See cloudflare/README.md for how to create the bucket + API token.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_BUCKET=nexusisland-releases
# The custom domain wired to the bucket (no trailing slash):
R2_PUBLIC_BASE_URL=https://releases.yourdomain.com
