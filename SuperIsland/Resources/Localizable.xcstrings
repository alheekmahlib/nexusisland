    "Offer Low Power mode when the Mac switches to battery or refresh work stays busy." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "اقترح وضع الطاقة المنخفضة عند انتقال الماك للبطارية أو ازدحام التحديثات." } } } },

